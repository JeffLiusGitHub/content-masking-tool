#!/bin/sh
set -eu

if [ "$(id -u)" -ne 0 ]; then
  echo "ERROR: managed uninstall must run as root." >&2
  exit 1
fi

PACKAGE_ID='@@PACKAGE_ID@@'
SERVER_ROOT='/Library/Application Support/ContentMaskingTool/maskingtool-server'
LAUNCHER='/usr/local/bin/maskingtool-server'
SELF='/Library/Application Support/ContentMaskingTool/uninstall.sh'
PRODUCT_ROOT='/Library/Application Support/ContentMaskingTool'

validate_owned_path() {
  case "$1" in
    ""|/|/Library|"/Library/Application Support"|/usr|/usr/local|/usr/local/bin)
      echo "ERROR: refusing dangerous uninstall target: '$1'" >&2
      exit 1
      ;;
    *'*'*|*'?'*|*'['*)
      echo "ERROR: refusing wildcard uninstall target: '$1'" >&2
      exit 1
      ;;
  esac
  case "$1" in
    "$SERVER_ROOT"|"$LAUNCHER"|"$SELF"|"$PRODUCT_ROOT") ;;
    *)
      echo "ERROR: target is outside the package allow-list: '$1'" >&2
      exit 1
      ;;
  esac
}

for target in "$SERVER_ROOT" "$LAUNCHER" "$SELF" "$PRODUCT_ROOT"; do
  validate_owned_path "$target"
done

# Program-file failures stop before the receipt is forgotten, leaving this
# helper available for a safe retry.
if [ -e "$LAUNCHER" ] || [ -L "$LAUNCHER" ]; then
  /bin/rm -f "$LAUNCHER"
fi
if [ -e "$SERVER_ROOT" ]; then
  /bin/rm -rf "$SERVER_ROOT"
fi

if /usr/sbin/pkgutil --pkg-info "$PACKAGE_ID" >/dev/null 2>&1; then
  /usr/sbin/pkgutil --forget "$PACKAGE_ID" >/dev/null
fi

# Self-removal is last. The running shell already has this file open.
/bin/rm -f "$SELF"
/bin/rmdir "$PRODUCT_ROOT" 2>/dev/null || true
