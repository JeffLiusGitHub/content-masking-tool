# The masking tool guarantees byte-for-byte round-trips (INV-1). Text
# fixtures and sources must check out with LF on every platform; otherwise
# Windows CI (git autocrlf=true) rewrites them to CRLF and the round-trip
# assertions — which compare masked/restored text against LF-normalized reads
# — fail. Force LF in the working tree for all text we control.
*.md       text eol=lf
*.markdown text eol=lf
*.txt      text eol=lf
*.json     text eol=lf
*.py       text eol=lf
*.csv      text eol=lf
*.html     text eol=lf
*.sh       text eol=lf

# Windows-only scripts keep CRLF to stay safe under cmd.exe.
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary assets: never normalize line endings.
*.docx binary
*.pdf  binary
*.png  binary
*.ico  binary
*.mcpb binary
*.zip  binary

# Keep GitHub's auto-generated "Source code" archives (git archive) lean:
# ship only what's needed to build and run + license and user docs. These
# rules affect the downloadable source tarball/zip ONLY — the repository
# itself is unchanged. Kept: src/, packaging/, pyproject.toml, uv.lock,
# LICENSE, README.md, USAGE.md, PRIVACY_DESIGN.md, THIRD_PARTY_NOTICES.md.
/tests             export-ignore
/demo              export-ignore
/docs              export-ignore
/.github           export-ignore
/.claude           export-ignore
/AGENTS.md         export-ignore
/CLAUDE.md         export-ignore
/PROGRESS.md       export-ignore
/RELEASING.md      export-ignore
/TESTING_GUIDE.md  export-ignore
/TESTPLAN.md       export-ignore
/CAPTURE_RUNBOOK.md export-ignore
/AUDIT_RUNBOOK.md  export-ignore
/AUDIT_GUIDE.md    export-ignore
